integrator               = steep
emtol                    = 1000.0
emstep                   = 0.01
nsteps                   = 15000

; Output
nstcomm                  = 100
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 5000
nstenergy                = 5000
nstxout-compressed       = 10000
compressed-x-precision   = 100

; Neighbor list and nonbonded interactions
cutoff-scheme            = Verlet
nstlist                  = 20
rlist                    = 1.35
verlet-buffer-tolerance  = -1
pbc                      = xyz

coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15
epsilon_rf               = 0

vdw-type                 = cutoff
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.1

; Constraints
constraints              = none
constraint-algorithm     = Lincs
lincs-iter               = 2
lincs-order              = 8
lincs-warnangle          = 90

continuation             = no
